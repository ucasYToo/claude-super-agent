{
  "name": "claude-super-agent",
  "version": "0.2.0",
  "description": "A local Claude assistant with background workers, Feishu and an embeddable web console",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ucasYToo/claude-super-agent.git"
  },
  "homepage": "https://github.com/ucasYToo/claude-super-agent#readme",
  "bugs": {
    "url": "https://github.com/ucasYToo/claude-super-agent/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "claude-super-agent": "bin/cli.js"
  },
  "files": [
    "dist",
    "bin",
    "web",
    "templates",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*/*.test.cjs",
    "prepack": "npm run build",
    "format": "prettier --write \"{src,bin,web,test}/**/*.{ts,js,cjs,css,html}\"",
    "format:check": "prettier --check \"{src,bin,web,test}/**/*.{ts,js,cjs,css,html}\"",
    "test:browser": "npm run build && node test/smoke/browser.cjs",
    "test:embedded": "node test/smoke/embedded.cjs",
    "test:package": "node test/smoke/package.cjs"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.68.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.16.0",
    "commander": "^11.1.0",
    "cron-parser": "^5.4.0",
    "express": "^4.21.2",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@types/proper-lockfile": "^4.1.4",
    "playwright-core": "^1.65.1",
    "prettier": "^3.10.1",
    "typescript": "^5.8.3"
  }
}
